# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/betbook?retryWrites=true&w=majority
# Replace USERNAME and PASSWORD with your actual MongoDB Database User credentials
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.gcksyyz.mongodb.net/betbook?retryWrites=true&w=majority
MONGODB_DB=betbook

# Secret key for signing session tokens (must be at least 32 characters)
JWT_SECRET=broww-super-secret-jwt-key-minimum-32-chars-long-xyz123!

# Master Admin Profile Configuration
ADMIN_NAME=naveen
ADMIN_SETUP_CODE=naveen123

# Server Port (for local testing at http://localhost:3000)
PORT=3000
